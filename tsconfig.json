{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "allowJs": true,
    "outDir": "./dist/",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "resolveJsonModule": false,
    "strictNullChecks": false,
    "removeComments": false,
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": ["node"],
    "strict": true,
  },
  "include": ["src/"],
  "exclude": [
    "dist",
    "test",
    "precode",
    "publish",
    "node_modules",
  ]
}
